// BFS

import java.util.*;

class Solution {
    static int R;
    static int C;
    static boolean[][] visited;
    static int[][] count;
    
    public int solution(int[][] maps) {
        R = maps.length;
        C = maps[0].length;
        visited = new boolean[R][C];
        count = new int[R][C];
        for(int i=0;i<R;i++){
            for(int j=0;j<C;j++){
                count[i][j] = maps[i][j];
                if (maps[i][j] == 0) {
                    visited[i][j] = true;
                }
            }
        }
        
        
        int answer = BFS(0,0);
        return answer;
    }
    
    static int BFS(int x, int y) {
        Queue<int[]> q = new LinkedList<>();
        q.offer(new int[] {x,y});
        int[] dr = {1,0,-1,0};
        int[] dc = {0,1,0,-1};
        
        while(!q.isEmpty()){
            int[] arr = q.poll();
            int r = arr[0];
            int c = arr[1];
            
            for(int i=0;i<4;i++) {
                int nr = r+dr[i];
                int nc = c+dc[i];
                
                if (check(nr,nc)){
                    q.offer(new int[]{nr,nc});
                    if (count[nr][nc] != 1){
                        count[nr][nc] = Math.min(count[r][c]+1,count[nr][nc]);
                    } else {
                        count[nr][nc] = count[r][c]+1;
                    }
                    if (nr==R-1 && nc==C-1)
                        return count[nr][nc];
                    visited[nr][nc] = true;
                }
            }
        }
        return -1;
    }
    
    static boolean check(int r, int c) {
        if (r<0 || r>=R || c<0 || c>=C || visited[r][c]){
            return false;
        }
        return true;
    }
    
}
